# ── 프론트엔드 (Nuxt 3) ──────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app/frontend
COPY saas/frontend/package.json saas/frontend/package-lock.json ./
RUN npm ci

COPY saas/frontend/ ./
# 위젯 원본을 콘솔 정적 자산으로 동기화 (Nuxt가 직접 서빙)
COPY saas/widget-dist/ ./public/widget-dist/

# 프로덕션 빌드 (API 호스트는 런타임에 설정)
ARG API_HOST=http://backend:8000
ENV NUXT_PUBLIC_API_HOST=${API_HOST}
RUN npm run build

# ── 실행 스테이지 ─────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app/frontend
COPY --from=build /app/frontend/.output ./.output
COPY --from=build /app/frontend/.nuxt ./.nuxt
COPY --from=build /app/frontend/public ./public

ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
